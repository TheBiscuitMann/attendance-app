# Copy this file to backend/.env and fill it in.
# backend/.env is gitignored — never commit real values.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-key-do-not-deploy

# True locally, False in production.
DEBUG=True

# Comma-separated. Add your real domain before deploying.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Railway and Render provide this
# automatically for their managed Postgres.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated origins allowed to call the API.
# In production this must be your deployed frontend URL only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Needed in production when the frontend is on a different domain.
# CSRF_TRUSTED_ORIGINS=https://prezence.vercel.app
